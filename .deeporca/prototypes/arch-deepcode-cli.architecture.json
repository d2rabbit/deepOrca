  "cards": [
    {
      "dot": "cyan",
      "title": "三层 Electron 边界清晰",
      "items": [
        "Renderer 只通过 preload IPC 访问核心能力，不能直接触碰文件/Git/MCP。",
        "IPC 安全策略按主窗口 webContents id + 精确文件 URL 校验来源。"
      ]
    },
    {
      "dot": "emerald",
      "title": "可扩展工具总线",
      "items": [
        "核心 MCP 管理器以 stdio/inMemory 接入外部服务器，并按需注入工具列表。",
        "工具执行器同时内置 Bash/Read/Write/Edit/WebSearch/WebFetch，并支持记忆检索工具桥接。"
      ]
    },
    {
      "dot": "violet",
      "title": "本地记忆优先",
      "items": [
        "MemoryManager 将 TDAI 流水线进程内化，替代旧版 HTTP sidecar。",
        "L0-L3 结果落盘到 SQLite/BM25，并支持本地 ONNX embedding 向量召回。"
      ]
    }
  ]
