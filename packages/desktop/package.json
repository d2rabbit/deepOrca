{
  "name": "@deeporca/desktop",
  "version": "0.1.34",
  "description": "DeepOrca Desktop — an Electron GUI client on top of the DeepOrca core engine",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d2rabbit/deepOrca.git"
  },
  "scripts": {
    "typecheck": "tsc -p ./ --noEmit",
    "test": "node src/tests/run-tests.mjs",
    "build": "node ./build.mjs",
    "dev": "node ./build.mjs --dev",
    "start": "electron .",
    "build-and-start": "npm run build && npm run start",
    "vendor:codegraph": "node ../../scripts/vendor-codegraph.js",
    "vendor:openwiki": "node ../../scripts/vendor-openwiki.js",
    "vendor:uv": "node ../../scripts/vendor-uv.js",
    "stage": "node ../../scripts/package-desktop.js",
    "package": "node ../../scripts/package-desktop.js && electron-builder --config electron-builder.yml --publish never"
  },
  "dependencies": {
    "@alibaba-group/open-code-review": "^1.8.0",
    "@colbymchenry/codegraph": "^1.5.0",
    "@deeporca/core": "file:../core",
    "@deeporca/memory": "file:../memory",
    "@monaco-editor/react": "^4.7.0",
    "@openuidev/lang-core": "^0.2.10",
    "@openuidev/react-lang": "^0.2.9",
    "@tencentdb-agent-memory/memory-tencentdb": "^0.3.6",
    "highlight.js": "^11.11.1",
    "marked": "^14.1.4",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  }
}
