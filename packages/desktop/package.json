{
  "name": "@deeporca/desktop",
  "version": "0.1.34",
  "description": "DeepOrca Desktop — an Electron GUI client on top of the DeepOrca core engine",
  "license": "MPL-2.0",
  "type": "module",
  "main": "./dist/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d2rabbit/deepOrca.git"
  },
  "scripts": {
    "ensure-stub": "node ./ensure-tailwind-stub.mjs",
    "typecheck": "npm run ensure-stub && tsc -p ./ --noEmit",
    "test": "node src/tests/run-tests.mjs",
    "build": "node ./build.mjs",
    "dev": "node ./build.mjs --dev",
    "start": "electron .",
    "build-and-start": "npm run build && npm run start",
    "vendor:openwiki": "node ../../scripts/vendor-openwiki.js",
    "vendor:uv": "node ../../scripts/vendor-uv.js",
    "stage": "node ../../scripts/package-desktop.js",
    "package": "node ../../scripts/package-desktop.js && electron-builder --config electron-builder.yml --publish never"
  },
  "dependencies": {
    "@a2ui/react": "^0.10.2",
    "@a2ui/web_core": "^0.10.6",
    "@alibaba-group/open-code-review": "^1.8.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/lsp-client": "^6.2.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@colbymchenry/codegraph": "^1.5.0",
    "@deeporca/core": "file:../core",
    "@deeporca/memory": "file:../memory",
    "@lezer/highlight": "^1.2.3",
    "@marp-team/marp-core": "4.4.0",
    "@open-file-viewer/core": "0.1.44",
    "@open-file-viewer/react": "0.1.44",
    "@openuidev/lang-core": "^0.2.17",
    "@openuidev/react-lang": "^0.2.15",
    "@openuidev/react-ui": "^0.13.10",
    "@streamdown/code": "^1.1.1",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.16.0",
    "motion": "^13.2.0",
    "pdfjs-dist": "4.10.38",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "remark-breaks": "^4.0.0",
    "streamdown": "^2.5.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1"
  }
}
