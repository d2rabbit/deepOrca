# OS metadata
.DS_Store
Thumbs.db

# Dependency directory
node_modules/
# Ignore built ts files
dist/
out/


# Editors
.idea/
.vscode/
*.tgz
*.log
*.vsix
.deepcode/settings.json
.deeporca/settings.json
.qoder/
.superpowers/
.zcode/

# TypeScript build info files
*.tsbuildinfo

# Environment variables
.env
.env.local

# Generated files
packages/*/src/generated/
# Legacy location of the auto-generated Tailwind script (now under
# packages/desktop/src/generated/). Kept so checkouts that still carry the old
# file don't re-add it after the move.
packages/desktop/src/renderer/dd/tailwind-script.ts

# Vendored third-party builds (checked out/downloaded + compiled at build time
# via scripts/vendor-*.js): CodeGraph, OpenWiki, uv, Serena, SkillSpector, CRG,
# Granite embedding model, …
packages/desktop/vendor/

# Pinned skill-up release binaries (scripts/get-skill-up.mjs) — CI-only tool,
# never vendored into the desktop build.
.cache/skill-up/

# Local verification scratch dirs
.tmp-verify/
.tmp-orca/
.tmp-gitmcp-e2e/

# Browser-automation session snapshots (run artifacts, not sources)
.playwright-mcp/

# Site verification screenshots (run artifacts, not sources)
.site-*.png

# Local security-tool scratch (not sources)
.mimosa/

# Generated workspace knowledge artifacts — the wiki pages and arch-map
# surfaces ARE committed (R3-8: they are reviewable products of the index
# build); only the binary CodeGraph DB (.codegraph/, has its own inner
# .gitignore) stays untracked.

