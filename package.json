{
  "name": "deeporca",
  "version": "0.1.34",
  "description": "DeepOrca — desktop client and core engine",
  "license": "MIT",
  "packageManager": "npm@10.9.4",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d2rabbit/deepOrca.git"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\" \"scripts/*.js\"",
    "lint:fix": "eslint \"packages/*/src/**/*.{ts,tsx}\" \"scripts/*.js\" --fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"scripts/*.js\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\" \"scripts/*.js\"",
    "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm run license:check && npm run deck:size",
    "license:check": "node scripts/check-licenses.js",
    "deck:size": "node scripts/check-deck-size.js",
    "clean": "node scripts/clean.js",
    "clean:artifacts": "node scripts/clean.js",
    "clean:all": "node scripts/clean.js --all",
    "build": "node scripts/build.js",
    "desktop:build": "npm run build --workspace @deeporca/desktop",
    "desktop:package": "npm run package --workspace @deeporca/desktop",
    "desktop:dev": "npm run dev --workspace @deeporca/desktop",
    "desktop:start": "npm run build-and-start --workspace @deeporca/desktop",
    "desktop:startWin": "node scripts/desktop-start.js win",
    "desktop:startMac": "node scripts/desktop-start.js mac",
    "desktop:startLx": "node scripts/desktop-start.js lx",
    "test": "npm run test --workspaces --if-present",
    "release:version": "node scripts/version.js",
    "prepare": "husky && npm run build",
    "openui:prompt": "node scripts/generate-openui-prompt.mjs --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/ejs": "^3.1.5",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "license-checker-rseidelsohn": "^4.4.2",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
